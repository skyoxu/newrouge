# Build and test artifacts
build/
# Keep SuperClaude-compatible scripts (source code) under scripts/sc/build
!scripts/sc/build/
!scripts/sc/build/**
reports/
logs/
gitlog/
godot_local/
tmp/
**/bin/
**/obj/
.vs/
TestResults/
# Keep GdUnit4 CLI runner scripts inside plugin bin
!Tests.Godot/addons/gdUnit4/bin/
!Tests.Godot/addons/gdUnit4/bin/**
# Tests.Godot must read the real game assets via Junction (do not version mirrored copies)
Tests.Godot/Game.Godot/
Tests.Godot/Game.Godot/**
# Godot/VS misc metadata not for VCS
*.uid
tmp_patch.txt

# Local .NET SDK/runtime placed in repo (should not be versioned)
.dotnet/

# IDE/editor caches (keep project configs if any are explicitly added elsewhere)
.idea/
.vscode/

# Python caches
__pycache__/
*.pyc

# Windows/macOS system files
Thumbs.db
.DS_Store

# Common local user files
*.user
*.suo
.claude/settings.local.json.bak

# Debug symbols/build outputs not meant for VCS
*.pdb

# Godot editor binaries/downloads (keep project assets only)
Godot_v*.exe
Godot_*.zip
godot/
tools/godot/
tools/fake-godot/

# Local: ignore cifix artifacts
cifix*.*

