\",\"target_id\":\"proposal:exclusive-resolution-v15-6\",\"relation\":\"projects_to\"},{\"source_type\":\"source_block\",\"source_id\":\"SB-3930A390340951B7\",\"target_type\":\"requirement\",\"target_id\":\"proposal:exclusive-resolution-v15-7\",\"relation\":\"projects_to\"},{\"source_type\":\"source_block\",\"source_id\":\"SB-83C0467B0FFB419F\",\"target_type\":\"requirement\",\"target_id\":\"proposal:exclusive-resolution-v15-7\",\"relation\":\"projects_to\"},{\"source_type\":\"source_block\",\"source_id\":\"SB-8C80E96FC81CA641\",\"target_type\":\"requirement\",\"target_id\":\"proposal:exclusive-resolution-v15-7\",\"relation\":\"projects_to\"}]}},\"unresolved\":[]},\"citation_guidance\":\"full-block\",\"producer_transport\":{\"schema_version\":\"input-identity-span-ref.v4\",\"mapping_identity\":\"sha256:c2a0ff9170df45f0c7328cc881b7b1aa6f03efa949568cbc324fe85e06c5f1f7\",\"spans\":[{\"span_ref\":\"span-000001\",\"path\":{\"$mvg_ref\":0},\"raw_digest\":{\"$mvg_ref\":1},\"block_id\":\"SB-8C80E96FC81CA641\",\"byte_start\":0,\"byte_end\":36},{\"span_ref\":\"span-000002\",\"path\":{\"$mvg_ref\":0},\"raw_digest\":{\"$mvg_ref\":1},\"block_id\":\"SB-3930A390340951B7\",\"byte_start\":38,\"byte_end\":790},{\"span_ref\":\"span-000003\",\"path\":{\"$mvg_ref\":0},\"raw_digest\":{\"$mvg_ref\":1},\"block_id\":\"SB-9E135AFD8D79ED3C\",\"byte_start\":792,\"byte_end\":1650},{\"span_ref\":\"span-000004\",\"path\":{\"$mvg_ref\":0},\"raw_digest\":{\"$mvg_ref\":1},\"block_id\":\"SB-B84109DE92C147BA\",\"byte_start\":1652,\"byte_end\":2665},{\"span_ref\":\"span-000005\",\"path\":{\"$mvg_ref\":0},\"raw_digest\":{\"$mvg_ref\":1},\"block_id\":\"SB-A9833CF255BDF6C0\",\"byte_start\":2667,\"byte_end\":4242},{\"span_ref\":\"span-000006\",\"path\":{\"$mvg_ref\":0},\"raw_digest\":{\"$mvg_ref\":1},\"block_id\":\"SB-F7DB8CD5A9668EF4\",\"byte_start\":4244,\"byte_end\":5519},{\"span_ref\":\"span-000007\",\"path\":{\"$mvg_ref\":0},\"raw_digest\":{\"$mvg_ref\":1},\"block_id\":\"SB-5B889D232D13901F\",\"byte_start\":5521,\"byte_end\":6308},{\"span_ref\":\"span-000008\",\"path\":{\"$mvg_ref\":0},\"raw_digest\":{\"$mvg_ref\":1},\"block_id\":\"SB-83C0467B0FFB419F\",\"byte_start\":6310,\"byte_end\":7059}]}}}}}\n===== END FILE: input.json =====\n\n===== FILE: schema.json =====\n{\"type\":\"object\",\"properties\":{\"schema_version\":{\"const\":\"newrouge.b-route-source-audit.v1.compare\",\"type\":\"string\"},\"input_identity\":{\"type\":\"string\",\"const\":\"sha256:cbeb936ba7e3d74c7e1fc228657154cabc493f2b1b62cd35a3340b1e9f79e6be\"},\"file_reviews\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"file\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"raw_digest\":{\"type\":\"string\"}},\"required\":[\"path\",\"raw_digest\"],\"additionalProperties\":false},\"reason\":{\"type\":\"string\"}},\"required\":[\"file\",\"reason\"],\"additionalProperties\":false}},\"disposition_reviews\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"block_id\":{\"type\":[\"string\",\"null\"]},\"decision\":{\"type\":\"string\",\"enum\":[\"accepted\",\"rejected\",\"unknown\"]},\"reason\":{\"type\":\"string\"},\"basis\":{\"type\":\"array\",\"items\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"span_ref\":{\"type\":\"string\",\"enum\":[\"span-000001\",\"span-000002\",\"span-000003\",\"span-000004\",\"span-000005\",\"span-000006\",\"span-000007\",\"span-000008\"]}},\"required\":[\"span_ref\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"raw_digest\":{\"type\":\"string\"},\"block_id\":{\"type\":[\"string\",\"null\"]},\"byte_start\":{\"type\":\"integer\",\"minimum\":0},\"byte_end\":{\"type\":\"integer\",\"minimum\":1},\"quote\":{\"type\":\"string\"}},\"required\":[\"path\",\"raw_digest\",\"block_id\",\"byte_start\",\"byte_end\",\"quote\"],\"additionalProperties\":false}]}},\"finding_ids\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"path\",\"block_id\",\"decision\",\"reason\",\"basis\",\"finding_ids\"],\"additionalProperties\":false}},\"obligation_reviews\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"local_id\":{\"type\":\"string\"},\"decision\":{\"type\":\"string\",\"enum\":[\"represented\",\"deferred\",\"out_of_scope\",\"omitted\",\"conflicting\",\"unknown\",\"underspecified\"]},\"proposal_ids\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"reason\":{\"type\":\"string\"},\"basis\":{\"type\":\"array\",\"items\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"span_ref\":{\"type\":\"string\",\"enum\":[\"span-000001\",\"span-000002\",\"span-000003\",\"span-000004\",\"span-000005\",\"span-000006\",\"span-000007\",\"span-000008\"]}},\"required\":[\"span_ref\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"raw_digest\":{\"type\":\"string\"},\"block_id\":{\"type\":[\"string\",\"null\"]},\"byte_start\":{\"type\":\"integer\",\"minimum\":0},\"byte_end\":{\"type\":\"integer\",\"minimum\":1},\"quote\":{\"type\":\"string\"}},\"required\":[\"path\",\"raw_digest\",\"block_id\",\"byte_start\",\"byte_end\",\"quote\"],\"additionalProperties\":false}]}},\"finding_ids\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"path\",\"local_id\",\"decision\",\"proposal_ids\",\"reason\",\"basis\",\"finding_ids\"],\"additionalProperties\":false}},\"findings\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"finding_id\":{\"type\":\"string\"},\"input_identity\":{\"type\":\"string\",\"const\":\"sha256:cbeb936ba7e3d74c7e1fc228657154cabc493f2b1b62cd35a3340b1e9f79e6be\"},\"classification\":{\"type\":\"string\",\"enum\":[\"omission\",\"conflict\",\"misclassification\",\"unknown\",\"underspecified\",\"unsupported_disposition\"]},\"severity\":{\"type\":\"string\",\"enum\":[\"blocking\"]},\"return_owner\":{\"type\":\"string\"},\"reason\":{\"type\":\"string\"},\"citations\":{\"type\":\"array\",\"items\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"span_ref\":{\"type\":\"string\",\"enum\":[\"span-000001\",\"span-000002\",\"span-000003\",\"span-000004\",\"span-000005\",\"span-000006\",\"span-000007\",\"span-000008\"]}},\"required\":[\"span_ref\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"raw_digest\":{\"type\":\"string\"},\"block_id\":{\"type\":[\"string\",\"null\"]},\"byte_start\":{\"type\":\"integer\",\"minimum\":0},\"byte_end\":{\"type\":\"integer\",\"minimum\":1},\"quote\":{\"type\":\"string\"}},\"required\":[\"path\",\"raw_digest\",\"block_id\",\"byte_start\",\"byte_end\",\"quote\"],\"additionalProperties\":false}]}},\"affected_proposal_ids\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"unprojected\":{\"type\":\"boolean\"}},\"required\":[\"finding_id\",\"input_identity\",\"classification\",\"severity\",\"return_owner\",\"reason\",\"citations\",\"affected_proposal_ids\",\"unprojected\"],\"additionalProperties\":false}}},\"required\":[\"schema_version\",\"input_identity\",\"file_reviews\",\"disposition_reviews\",\"obligation_reviews\",\"findings\"],\"additionalProperties\":false}\n===== END FILE: schema.json =====\n"}],"outputSchema":{"type":"object","properties":{"schema_version":{"const":"newrouge.b-route-source-audit.v1.compare","type":"string"},"input_identity":{"type":"string","const":"sha256:cbeb936ba7e3d74c7e1fc228657154cabc493f2b1b62cd35a3340b1e9f79e6be"},"file_reviews":{"type":"array","items":{"type":"object","properties":{"file":{"type":"object","properties":{"path":{"type":"string"},"raw_digest":{"type":"string"}},"required":["path","raw_digest"],"additionalProperties":false},"reason":{"type":"string"}},"required":["file","reason"],"additionalProperties":false}},"disposition_reviews":{"type":"array","items":{"type":"object","properties":{"path":{"type":"string"},"block_id":{"type":["string","null"]},"decision":{"type":"string","enum":["accepted","rejected","unknown"]},"reason":{"type":"string"},"basis":{"type":"array","items":{"anyOf":[{"type":"object","properties":{"span_ref":{"type":"string","enum":["span-000001","span-000002","span-000003","span-000004","span-000005","span-000006","span-000007","span-000008"]}},"required":["span_ref"],"additionalProperties":false},{"type":"object","properties":{"path":{"type":"string"},"raw_digest":{"type":"string"},"block_id":{"type":["string","null"]},"byte_start":{"type":"integer","minimum":0},"byte_end":{"type":"integer","minimum":1},"quote":{"type":"string"}},"required":["path","raw_digest","block_id","byte_start","byte_end","quote"],"additionalProperties":false}]}},"finding_ids":{"type":"array","items":{"type":"string"}}},"required":["path","block_id","decision","reason","basis","finding_ids"],"additionalProperties":false}},"obligation_reviews":{"type":"array","items":{"type":"object","properties":{"path":{"type":"string"},"local_id":{"type":"string"},"decision":{"type":"string","enum":["represented","deferred","out_of_scope","omitted","conflicting","unknown","underspecified"]},"proposal_ids":{"type":"array","items":{"type":"string"}},"reason":{"type":"string"},"basis":{"type":"array","items":{"anyOf":[{"type":"object","properties":{"span_ref":{"type":"string","enum":["span-000001","span-000002","span-000003","span-000004","span-000005","span-000006","span-000007","span-000008"]}},"required":["span_ref"],"additionalProperties":false},{"type":"object","properties":{"path":{"type":"string"},"raw_digest":{"type":"string"},"block_id":{"type":["string","null"]},"byte_start":{"type":"integer","minimum":0},"byte_end":{"type":"integer","minimum":1},"quote":{"type":"string"}},"required":["path","raw_digest","block_id","byte_start","byte_end","quote"],"additionalProperties":false}]}},"finding_ids":{"type":"array","items":{"type":"string"}}},"required":["path","local_id","decision","proposal_ids","reason","basis","finding_ids"],"additionalProperties":false}},"findings":{"type":"array","items":{"type":"object","properties":{"finding_id":{"type":"string"},"input_identity":{"type":"string","const":"sha256:cbeb936ba7e3d74c7e1fc228657154cabc493f2b1b62cd35a3340b1e9f79e6be"},"classification":{"type":"string","enum":["omission","conflict","misclassification","unknown","underspecified","unsupported_disposition"]},"severity":{"type":"string","enum":["blocking"]},"return_owner":{"type":"string"},"reason":{"type":"string"},"citations":{"type":"array","items":{"anyOf":[{"type":"object","properties":{"span_ref":{"type":"string","enum":["span-000001","span-000002","span-000003","span-000004","span-000005","span-000006","span-000007","span-000008"]}},"required":["span_ref"],"additionalProperties":false},{"type":"object","properties":{"path":{"type":"string"},"raw_digest":{"type":"string"},"block_id":{"type":["string","null"]},"byte_start":{"type":"integer","minimum":0},"byte_end":{"type":"integer","minimum":1},"quote":{"type":"string"}},"required":["path","raw_digest","block_id","byte_start","byte_end","quote"],"additionalProperties":false}]}},"affected_proposal_ids":{"type":"array","items":{"type":"string"}},"unprojected":{"type":"boolean"}},"required":["finding_id","input_identity","classification","severity","return_owner","reason","citations","affected_proposal_ids","unprojected"],"additionalProperties":false}}},"required":["schema_version","input_identity","file_reviews","disposition_reviews","obligation_reviews","findings"],"additionalProperties":false}}}}
