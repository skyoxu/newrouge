",\"source_block_ids\":[\"SB-8C80E96FC81CA641\"]},\"review_status\":\"review_required\",\"reused_from_source_revision\":null},{\"block_id\":\"SB-3930A390340951B7\",\"batch_id\":\"BATCH-0001\",\"block_content_hash\":{\"$mvg_ref\":11},\"requirement_ids\":[\"proposal:exclusive-resolution-v15-1\"],\"disposition\":\"atomized\",\"delivery_potential\":true,\"decision\":null,\"review_status\":\"review_required\",\"reused_from_source_revision\":null},{\"block_id\":\"SB-9E135AFD8D79ED3C\",\"batch_id\":\"BATCH-0001\",\"block_content_hash\":{\"$mvg_ref\":13},\"requirement_ids\":[\"proposal:exclusive-resolution-v15-2\"],\"disposition\":\"atomized\",\"delivery_potential\":true,\"decision\":null,\"review_status\":\"review_required\",\"reused_from_source_revision\":null},{\"block_id\":\"SB-B84109DE92C147BA\",\"batch_id\":\"BATCH-0001\",\"block_content_hash\":{\"$mvg_ref\":15},\"requirement_ids\":[\"proposal:exclusive-resolution-v15-3\"],\"disposition\":\"atomized\",\"delivery_potential\":true,\"decision\":null,\"review_status\":\"review_required\",\"reused_from_source_revision\":null},{\"block_id\":\"SB-A9833CF255BDF6C0\",\"batch_id\":\"BATCH-0001\",\"block_content_hash\":{\"$mvg_ref\":17},\"requirement_ids\":[\"proposal:exclusive-resolution-v15-4\"],\"disposition\":\"atomized\",\"delivery_potential\":true,\"decision\":null,\"review_status\":\"review_required\",\"reused_from_source_revision\":null},{\"block_id\":\"SB-F7DB8CD5A9668EF4\",\"batch_id\":\"BATCH-0001\",\"block_content_hash\":{\"$mvg_ref\":19},\"requirement_ids\":[\"proposal:exclusive-resolution-v15-5\"],\"disposition\":\"atomized\",\"delivery_potential\":true,\"decision\":null,\"review_status\":\"review_required\",\"reused_from_source_revision\":null},{\"block_id\":\"SB-5B889D232D13901F\",\"batch_id\":\"BATCH-0001\",\"block_content_hash\":{\"$mvg_ref\":21},\"requirement_ids\":[\"proposal:exclusive-resolution-v15-6\"],\"disposition\":\"atomized\",\"delivery_potential\":true,\"decision\":null,\"review_status\":\"review_required\",\"reused_from_source_revision\":null},{\"block_id\":\"SB-83C0467B0FFB419F\",\"batch_id\":\"BATCH-0001\",\"block_content_hash\":{\"$mvg_ref\":23},\"requirement_ids\":[\"proposal:exclusive-resolution-v15-7\"],\"disposition\":\"atomized\",\"delivery_potential\":true,\"decision\":null,\"review_status\":\"review_required\",\"reused_from_source_revision\":null}],\"file_accounting\":[],\"projection_checks\":{\"binding_mismatches\":[],\"duplicate_accounting_blocks\":[],\"unaccounted_source_blocks\":[],\"unknown_accounting_blocks\":[],\"invalid_semantics\":[],\"invalid_source_accounting\":[],\"source_hash_drift\":[],\"unresolved_delivery_potential\":[],\"unresolved_delivery_requirements\":[],\"source_block_count\":8,\"semantic_requirement_count\":7},\"edges\":{\"schema_version\":\"newrouge.topology-edges.v1\",\"source_revision\":\"source-set:45704214c4b741ba6aebe705\",\"edges\":[{\"source_type\":\"source_block\",\"source_id\":\"SB-3930A390340951B7\",\"target_type\":\"requirement\",\"target_id\":\"proposal:exclusive-resolution-v15-1\",\"relation\":\"projects_to\"},{\"source_type\":\"source_block\",\"source_id\":\"SB-8C80E96FC81CA641\",\"target_type\":\"requirement\",\"target_id\":\"proposal:exclusive-resolution-v15-1\",\"relation\":\"projects_to\"},{\"source_type\":\"source_block\",\"source_id\":\"SB-3930A390340951B7\",\"target_type\":\"requirement\",\"target_id\":\"proposal:exclusive-resolution-v15-2\",\"relation\":\"projects_to\"},{\"source_type\":\"source_block\",\"source_id\":\"SB-8C80E96FC81CA641\",\"target_type\":\"requirement\",\"target_id\":\"proposal:exclusive-resolution-v15-2\",\"relation\":\"projects_to\"},{\"source_type\":\"source_block\",\"source_id\":\"SB-9E135AFD8D79ED3C\",\"target_type\":\"requirement\",\"target_id\":\"proposal:exclusive-resolution-v15-2\",\"relation\":\"projects_to\"},{\"source_type\":\"source_block\",\"source_id\":\"SB-3930A390340951B7\",\"target_type\":\"requirement\",\"target_id\":\"proposal:exclusive-resolution-v15-3\",\"relation\