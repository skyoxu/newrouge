: \"Observations remain after completion and before another call or lifecycle control, with unchanged UI and J throughout.\",\n      \"basis\": [\n        {\n          \"span_ref\": \"span-000005\"\n        }\n      ],\n      \"finding_ids\": []\n    },\n    {\n      \"path\": \"docs/testing/story-2-5-controlled-acceptance/exclusive-resolution-v15.md\",\n      \"local_id\": \"25\",\n      \"decision\": \"represented\",\n      \"proposal_ids\": [\n        \"proposal:exclusive-resolution-v15-4\"\n      ],\n      \"reason\": \"Every identity, actual-versus-reported UI, full journal, count and deadline check is retained, including failures that survive later crashes.\",\n      \"basis\": [\n        {\n          \"span_ref\": \"span-000005\"\n        }\n      ],\n      \"finding_ids\": []\n    },\n    {\n      \"path\": \"docs/testing/story-2-5-controlled-acceptance/exclusive-resolution-v15.md\",\n      \"local_id\": \"26\",\n      \"decision\": \"represented\",\n      \"proposal_ids\": [\n        \"proposal:exclusive-resolution-v15-4\"\n      ],\n      \"reason\": \"ObservationComplete follows all timely local checks and remains provisional while permitting subsequent work.\",\n      \"basis\": [\n        {\n          \"span_ref\": \"span-000005\"\n        }\n      ],\n      \"finding_ids\": []\n    },\n    {\n      \"path\": \"docs/testing/story-2-5-controlled-acceptance/exclusive-resolution-v15.md\",\n      \"local_id\": \"27\",\n      \"decision\": \"represented\",\n      \"proposal_ids\": [\n        \"proposal:exclusive-resolution-v15-4\"\n      ],\n      \"reason\": \"Retained call identities and counts are audited through EOF/drain, requiring one non-crashing completion, zero crash-injected completions and failure on late duplicates.\",\n      \"basis\": [\n        {\n          \"span_ref\": \"span-000005\"\n        }\n      ],\n      \"finding_ids\": []\n    },\n    {\n      \"path\": \"docs/testing/story-2-5-controlled-acceptance/exclusive-resolution-v15.md\",\n      \"local_id\": \"28\",\n      \"decision\": \"represented\",\n      \"proposal_ids\": [\n        \"proposal:exclusive-resolution-v15-4\"\n      ],\n      \"reason\": \"The EOF Ready audit retains exact count, correct identity, original startup timeliness and failure on missing, wrong, duplicate or reparative late Ready.\",\n      \"basis\": [\n        {\n          \"span_ref\": \"span-000005\"\n        }\n      ],\n      \"finding_ids\": []\n    },\n    {\n      \"path\": \"docs/testing/story-2-5-controlled-acceptance/exclusive-resolution-v15.md\",\n      \"local_id\": \"29\",\n      \"decision\": \"represented\",\n      \"proposal_ids\": [\n        \"proposal:exclusive-resolution-v15-4\"\n      ],\n      \"reason\": \"Success remains conditional on final normal exit confirmation and count audit, with no extra reward call or restart during teardown.\",\n      \"basis\": [\n        {\n          \"span_ref\": \"span-000005\"\n        }\n      ],\n      \"finding_ids\": []\n    },\n    {\n      \"path\": \"docs/testing/story-2-5-controlled-acceptance/exclusive-resolution-v15.md\",\n      \"local_id\": \"30\",\n      \"decision\": \"represented\",\n      \"proposal_ids\": [\n        \"proposal:exclusive-resolution-v15-5\"\n      ],\n      \"reason\": \"Injected crashes remain restricted to before or after an accept/cancel append in a fresh empty-J scenario.\",\n      \"basis\": [\n        {\n          \"span_ref\": \"span-000006\"\n        }\n      ],\n      \"finding_ids\": []\n    },\n    {\n      \"path\": \"docs/testing/story-2-5-controlled-acceptance/exclusive-resolution-v15.md\",\n      \"local_id\": \"31\",\n      \"decision\": \"represented\",\n      \"proposal_ids\": [\n        \"proposal:exclusive-resolution-v15-5\"\n      ],\n      \"reason\": \"CallStart, armHook on Q and matching acknowledgement precede issue; the one-shot hook remains limited to the specified id/op with empty J.\",\n      \"basis\": [\n        {\n          \"span_ref\": \"span-000006\