+def _is_original_source_metadata(command, args, kwargs):
+    call = _original_metadata_call()
+    if call is None:
+        return False
+    options = call['options']
+    constructor = {k: options[k] for k in ('stdout', 'stderr', 'creationflags')}
+    if options['input'] is not None:
+        constructor['stdin'] = subprocess.PIPE
+    if 'cwd' in options:
+        constructor['cwd'] = options['cwd']
+    require(list(command) == call['argv'] and args == () and kwargs == constructor,
+            'exact_original_metadata_through_captured_prior')
+    return True
