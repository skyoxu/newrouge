+def _manifest_query_matches(arguments, input_bytes, *, tracked_names=None):
+    """Pure finite-query DATA check; never sufficient for a metadata role."""
+    if type(arguments) is not tuple:
+        return False
+    commit = _PRESERVED_COMMIT
+    if arguments in {('rev-parse', '--verify', commit + '^{commit}'),
+                     ('ls-tree', '-rz', '--full-tree', commit),
+                     ('ls-tree', '-rz', '--full-tree', 'HEAD'),
+                     ('ls-files', '--others', '-z')}:
+        return input_bytes is None
+    expected = ('check-attr', '--source=' + commit, '--stdin', '-z',
+                'text', 'eol', 'filter', 'working-tree-encoding', 'ident')
+    return (arguments == expected and tracked_names is not None
+            and input_bytes == b'\x00'.join(name.encode('utf-8') for name in sorted(tracked_names)) + b'\x00')
+
