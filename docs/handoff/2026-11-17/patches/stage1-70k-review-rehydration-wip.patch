+        "input_stage": prior_projection["input_stage"],
+        "input_identity": prior_projection["input_identity"],
+        "proposal_sha256": prior_projection["proposal_sha256"],
+        "provenance_summary": deepcopy(prior_projection["provenance_summary"]),
