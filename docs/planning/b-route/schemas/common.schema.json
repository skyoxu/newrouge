        {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "#/$defs/String"
            },
            "schema_version": {
              "enum": [
                "newrouge.b-route-policy.v1",
                "newrouge.b-route-plan.v1",
                "newrouge.b-route-binding.v1",
                "newrouge.b-route-origins.v1",
                "newrouge.b-route-commit.v1",
                "newrouge.b-route-catalog.v1"
              ]
            },
            "entity_id": {
              "$ref": "#/$defs/String"
            },
            "revision": {
              "$ref": "#/$defs/PositiveInteger"
            },
            "digest": {
              "$ref": "#/$defs/Digest"
            },
            "verification_mode": {
              "const": "raw"
            },
            "codec_version": {
              "type": "null"
            }
          },
          "required": [
            "path",
            "schema_version",
            "entity_id",
            "revision",
            "digest",
            "verification_mode",
            "codec_version"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "#/$defs/String"
            },
            "schema_version": {
