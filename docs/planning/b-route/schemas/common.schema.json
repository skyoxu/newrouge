{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newrouge.b-route-common.v1",
  "title": "Shared B-route record definitions",
  "$defs": {
    "String": {
      "type": "string",
      "pattern": "\\S"
    },
    "PositiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "FileId": {
      "type": "string",
      "pattern": "^(?![.]{1,2}$)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:[.].*)?$)[^\\\\/:<>\"|?*\\u0000-\\u001f]*[^\\\\/:<>\"|?*\\u0000-\\u001f .](?![\\s\\S])"
    },
    "PartKind": {
      "enum": [
        "domain_rules",
        "csharp_adapter",
        "binding",
        "scene"
      ]
    },
    "DefinitionKind": {
      "enum": [
        "flow",
        "command",
        "state"
      ]
    },
    "PublicRecordRef": {
