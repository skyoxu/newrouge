{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newrouge.b-route-verification-scope.v1",
  "title": "B-route executable three-tier VerificationScope (auxiliary, non-formal)",
  "type": "object",
  "$defs": {
    "Tier": {
      "enum": ["existing_required", "current_new", "out_of_scope_future"]
    },
    "CurrentTier": {
      "enum": ["existing_required", "current_new"]
    },
    "Status": {
      "enum": ["ready_to_execute", "pending", "blocked", "tracked_future", "manual_required"]
    },
    "EvidenceLevel": {
      "enum": ["domain-integration", "scene-method", "engine-input", "static-wiring", "other-verification", "manual", "unimplemented"]
    },
    "StringList": {
      "type": "array",
      "items": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
      "uniqueItems": true
    },
    "TaskIdList": {
      "type": "array",
      "items": {"$ref": "newrouge.b-route-common.v1#/$defs/PositiveInteger"},
      "uniqueItems": true
    },
    "NullableString": {
      "oneOf": [{"type": "null"}, {"$ref": "newrouge.b-route-common.v1#/$defs/String"}]
    },
    "NullableRevision": {
      "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]
    },
    "NullableDigest": {
      "oneOf": [{"type": "null"}, {"$ref": "newrouge.b-route-common.v1#/$defs/Digest"}]
    },
    "ChangeRoot": {
      "type": "object",
      "properties": {
        "kind": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "id": {"$ref": "newrouge.b-route-common.v1#/$defs/String"}
      },
      "required": ["kind", "id"],
      "additionalProperties": false
    },
    "ManifestDescriptor": {
      "type": "object",
      "properties": {
        "manifest_id": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "path": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "manifest_sha256": {"$ref": "newrouge.b-route-common.v1#/$defs/Digest"},
        "roles": {
          "type": "array",
          "items": {"enum": ["active", "baseline"]},
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["manifest_id", "path", "manifest_sha256", "roles"],
      "additionalProperties": false
    },
    "SemanticOwner": {
      "type": "object",
      "properties": {
        "owner_plan_id": {"$ref": "#/$defs/NullableString"},
        "kind": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "id": {"$ref": "newrouge.b-route-common.v1#/$defs/String"}
      },
      "required": ["owner_plan_id", "kind", "id"],
      "additionalProperties": false
    },
    "SourceAuthority": {
      "type": "object",
      "properties": {
        "plan_id": {"$ref": "#/$defs/NullableString"},
        "plan_revision": {"$ref": "#/$defs/NullableRevision"},
        "binding_revision": {"$ref": "#/$defs/NullableRevision"},
        "manifest_id": {"$ref": "#/$defs/NullableString"},
        "manifest_sha256": {"$ref": "#/$defs/NullableDigest"}
      },
      "required": ["plan_id", "plan_revision", "binding_revision", "manifest_id", "manifest_sha256"],
      "additionalProperties": false
    },
    "Obligation": {
      "type": "object",
      "properties": {
        "obligation_id": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "tier": {"$ref": "#/$defs/Tier"},
        "status": {"$ref": "#/$defs/Status"},
        "blocking_current_delivery": {"type": "boolean"},
        "immediate_execution_required": {"type": "boolean"},
        "flow_ids": {"$ref": "#/$defs/StringList"},
        "requirement_ids": {"$ref": "#/$defs/StringList"},
        "task_ids": {"$ref": "#/$defs/TaskIdList"},
        "test_ids": {"$ref": "#/$defs/StringList"},
        "other_verification_refs": {"$ref": "#/$defs/StringList"},
        "semantic_owner": {"$ref": "#/$defs/SemanticOwner"},
        "execution_kind": {
          "enum": ["executable_test", "other_verification", "pending_implementation", "manual_check", "future_followup"]
        },
        "evidence_level": {"$ref": "#/$defs/EvidenceLevel"},
        "follow_up_responsibilities": {"$ref": "#/$defs/StringList"},
        "source_authority": {"$ref": "#/$defs/SourceAuthority"},
        "claimed_passed": {"const": false},
        "classification_reasons": {"$ref": "#/$defs/StringList"},
        "missing_targets": {"$ref": "#/$defs/StringList"},
        "input_fingerprint": {"$ref": "newrouge.b-route-common.v1#/$defs/Digest"}
      },
      "required": [
        "obligation_id", "tier", "status", "blocking_current_delivery", "immediate_execution_required",
        "flow_ids", "requirement_ids", "task_ids", "test_ids", "other_verification_refs", "semantic_owner",
        "execution_kind", "evidence_level", "follow_up_responsibilities", "source_authority", "claimed_passed",
        "classification_reasons", "missing_targets", "input_fingerprint"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"tier": {"const": "out_of_scope_future"}}},
          "then": {
            "properties": {
              "status": {"const": "tracked_future"},
              "blocking_current_delivery": {"const": false},
              "immediate_execution_required": {"const": false},
              "execution_kind": {"const": "future_followup"},
              "follow_up_responsibilities": {"minItems": 1}
            }
          },
          "else": {
            "properties": {
              "status": {"enum": ["ready_to_execute", "pending", "blocked", "manual_required"]},
              "blocking_current_delivery": {"const": true},
              "immediate_execution_required": {"const": true}
            }
          }
        }
      ]
    },
    "FlowClassification": {
      "type": "object",
      "properties": {
        "flow_id": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "in_current_delivery_scope": {"type": "boolean"},
        "has_existing_required": {"type": "boolean"},
        "has_current_new": {"type": "boolean"},
        "has_out_of_scope_future": {"type": "boolean"},
        "mixed_tiers": {"type": "boolean"},
        "blocking_current_delivery": {"type": "boolean"},
        "obligation_ids": {"$ref": "#/$defs/StringList"}
      },
      "required": [
        "flow_id", "in_current_delivery_scope", "has_existing_required", "has_current_new",
        "has_out_of_scope_future", "mixed_tiers", "blocking_current_delivery", "obligation_ids"
      ],
      "additionalProperties": false
    },
    "ExecutableTest": {
      "type": "object",
      "properties": {
        "test_id": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "obligation_id": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "kind": {"enum": ["dotnet", "gdunit", "other_verification"]},
        "evidence_level": {"$ref": "#/$defs/EvidenceLevel"},
        "path": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "selector": {"$ref": "#/$defs/NullableString"},
        "min_tests": {
          "oneOf": [{"type": "null"}, {"$ref": "newrouge.b-route-common.v1#/$defs/PositiveInteger"}]
        },
        "tier": {"$ref": "#/$defs/CurrentTier"},
        "flow_ids": {"$ref": "#/$defs/StringList"},
        "requirement_ids": {"$ref": "#/$defs/StringList"},
        "challenge": {"$ref": "#/$defs/NullableString"}
      },
      "required": [
        "test_id", "obligation_id", "kind", "evidence_level", "path", "selector", "min_tests", "tier",
        "flow_ids", "requirement_ids", "challenge"
      ],
      "additionalProperties": false
    },
    "PendingObligation": {
      "type": "object",
      "properties": {
        "obligation_id": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "tier": {"$ref": "#/$defs/Tier"},
        "status": {"enum": ["pending", "blocked", "tracked_future"]},
        "reason": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "blocking_current_delivery": {"type": "boolean"},
        "missing_targets": {"$ref": "#/$defs/StringList"},
        "responsible_task_ids": {"$ref": "#/$defs/TaskIdList"},
        "flow_ids": {"$ref": "#/$defs/StringList"},
        "requirement_ids": {"$ref": "#/$defs/StringList"}
      },
      "required": [
        "obligation_id", "tier", "status", "reason", "blocking_current_delivery", "missing_targets",
        "responsible_task_ids", "flow_ids", "requirement_ids"
      ],
      "additionalProperties": false
    },
    "ManualObligation": {
      "type": "object",
      "properties": {
        "manual_id": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "tier": {"$ref": "#/$defs/Tier"},
        "source": {"enum": ["human_verification", "manifest_excluded_claim", "other_verification_document"]},
        "flow_ids": {"$ref": "#/$defs/StringList"},
        "requirement_ids": {"$ref": "#/$defs/StringList"},
        "owner_plan_id": {"$ref": "#/$defs/NullableString"},
        "responsibilities": {
          "type": "array",
          "items": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
          "minItems": 1
        },
        "blocking_current_delivery": {"type": "boolean"}
      },
      "required": [
        "manual_id", "tier", "source", "flow_ids", "requirement_ids", "owner_plan_id", "responsibilities",
        "blocking_current_delivery"
      ],
      "additionalProperties": false
    },
    "OtherVerificationObligation": {
      "type": "object",
      "properties": {
        "obligation_id": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "tier": {"$ref": "#/$defs/Tier"},
        "requirement_ids": {"$ref": "#/$defs/StringList"},
        "rationale": {"$ref": "#/$defs/NullableString"},
        "verification_paths": {"$ref": "#/$defs/StringList"},
        "status": {"$ref": "#/$defs/Status"},
        "blocking_current_delivery": {"type": "boolean"},
        "links_mvg_flow_ids": {"$ref": "#/$defs/StringList"}
      },
      "required": [
        "obligation_id", "tier", "requirement_ids", "rationale", "verification_paths", "status",
        "blocking_current_delivery", "links_mvg_flow_ids"
      ],
      "additionalProperties": false
    },
    "UnknownItem": {
      "type": "object",
      "properties": {
        "entity": {"$ref": "#/$defs/NullableString"},
        "reason": {"$ref": "#/$defs/NullableString"},
        "owning_stage": {"$ref": "#/$defs/NullableString"},
        "authority_ref": {"$ref": "#/$defs/NullableString"},
        "partition_key": {"$ref": "#/$defs/NullableString"}
      },
      "required": ["entity", "reason", "owning_stage", "authority_ref", "partition_key"],
      "additionalProperties": false
    },
    "TaskInputSet": {
      "type": "object",
      "properties": {
        "task_id": {"$ref": "newrouge.b-route-common.v1#/$defs/PositiveInteger"},
        "input_set_digest": {"$ref": "newrouge.b-route-common.v1#/$defs/Digest"},
        "route": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "valid_input_set": {"type": "boolean"},
        "reason_code": {"$ref": "newrouge.b-route-common.v1#/$defs/String"}
      },
      "required": ["task_id", "input_set_digest", "route", "valid_input_set", "reason_code"],
      "additionalProperties": false
    },
    "Gap": {
      "type": "object",
      "properties": {
        "entity": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "reason": {"$ref": "newrouge.b-route-common.v1#/$defs/String"}
      },
      "required": ["entity", "reason"],
      "additionalProperties": false
    },
    "AppliedDeltaChange": {
      "type": "object",
      "properties": {
        "obligation_id": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "tier": {"$ref": "#/$defs/Tier"},
        "action": {"enum": ["retire", "remove", "shrink", "reclassify"]},
        "reason": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "target_tier": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Tier"}]},
        "source_authority_ref": {"$ref": "#/$defs/NullableString"},
        "anti_weakening_review_ref": {"$ref": "#/$defs/NullableString"}
      },
      "required": [
        "obligation_id", "tier", "action", "reason", "target_tier", "source_authority_ref",
        "anti_weakening_review_ref"
      ],
      "additionalProperties": false
    },
    "ScopeDeltaChange": {
      "type": "object",
      "properties": {
        "action": {"enum": ["retire", "remove", "shrink", "reclassify"]},
        "obligation_id": {"$ref": "#/$defs/NullableString"},
        "flow_id": {"$ref": "#/$defs/NullableString"},
        "test_id": {"$ref": "#/$defs/NullableString"},
        "target_tier": {"oneOf": [{"type": "null"}, {"enum": ["existing_required", "current_new", "out_of_scope_future", "planned"]}]},
        "reason": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "source_authority_ref": {"$ref": "#/$defs/NullableString"},
        "anti_weakening_review_ref": {"$ref": "#/$defs/NullableString"}
      },
      "required": ["action", "reason"],
      "additionalProperties": false
    },
    "ScopeDeltaRecord": {
      "type": "object",
      "properties": {
        "schema_version": {"const": "newrouge.b-route-verification-scope-delta.v1"},
        "changes": {"type": "array", "items": {"$ref": "#/$defs/ScopeDeltaChange"}, "minItems": 1}
      },
      "required": ["schema_version", "changes"],
      "additionalProperties": false
    },
    "DiagnosticItem": {
      "type": "object",
      "properties": {
        "reason_code": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
        "stage": {"$ref": "#/$defs/NullableString"},
        "entity_id": {"$ref": "#/$defs/NullableString"},
        "expected": true,
        "actual": true,
        "resume_ref": {"$ref": "#/$defs/NullableString"}
      },
      "required": ["reason_code"],
      "additionalProperties": false
    },
    "Metrics": {
      "type": "object",
      "properties": {
        "active_elapsed_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"const": "newrouge.b-route-verification-scope.v1"},
    "ok": {"const": true},
    "status": {"const": "scope_built"},
    "operation": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
    "reason_code": {"const": "ok"},
    "generated_at": {"$ref": "newrouge.b-route-common.v1#/$defs/String"},
    "scope_id": {"$ref": "newrouge.b-route-common.v1#/$defs/Digest"},
    "input_set_digest": {"$ref": "newrouge.b-route-common.v1#/$defs/Digest"},
    "task_input_set_digests": {"type": "array", "items": {"$ref": "#/$defs/TaskInputSet"}},
    "request": {
      "type": "object",
      "properties": {
        "change_roots": {"type": "array", "items": {"$ref": "#/$defs/ChangeRoot"}, "minItems": 1},
        "impact_manifest_paths": {"$ref": "#/$defs/StringList"},
        "in_scope_task_ids": {"$ref": "#/$defs/TaskIdList"},
        "in_scope_plan_ids": {"$ref": "#/$defs/StringList"},
        "in_scope_flow_ids": {"$ref": "#/$defs/StringList"},
        "manifest_paths": {"$ref": "#/$defs/StringList"},
        "cumulative_baseline_manifests": {"$ref": "#/$defs/StringList"},
        "scope_delta": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ScopeDeltaRecord"}]}
      },
      "required": [
        "change_roots", "impact_manifest_paths", "in_scope_task_ids", "in_scope_plan_ids", "in_scope_flow_ids",
        "manifest_paths", "cumulative_baseline_manifests", "scope_delta"
      ],
      "additionalProperties": false
    },
    "delivery_boundary": {
      "type": "object",
      "properties": {
        "in_scope_plan_ids": {"$ref": "#/$defs/StringList"},
        "in_scope_task_ids": {"$ref": "#/$defs/TaskIdList"},
        "in_scope_flow_ids": {"$ref": "#/$defs/StringList"},
        "in_scope_requirement_ids": {"$ref": "#/$defs/StringList"},
        "baseline_manifest_refs": {"$ref": "#/$defs/StringList"},
        "active_manifest_refs": {"$ref": "#/$defs/StringList"}
      },
      "required": [
        "in_scope_plan_ids", "in_scope_task_ids", "in_scope_flow_ids", "in_scope_requirement_ids",
        "baseline_manifest_refs", "active_manifest_refs"
      ],
      "additionalProperties": false
    },
    "authority_refs": {
      "type": "object",
      "properties": {
        "plan_refs": {"type": "array", "items": {"$ref": "newrouge.b-route-common.v1#/$defs/PlanRef"}},
        "binding_refs": {"type": "array", "items": {"$ref": "newrouge.b-route-common.v1#/$defs/BindingRef"}},
        "manifest_refs": {"type": "array", "items": {"$ref": "#/$defs/ManifestDescriptor"}},
        "cumulative_baseline_refs": {"type": "array", "items": {"$ref": "#/$defs/ManifestDescriptor"}},
        "governed_delta_refs": {"type": "array", "items": {"$ref": "newrouge.b-route-common.v1#/$defs/OwnedRef"}}
      },
      "required": ["plan_refs", "binding_refs", "manifest_refs", "cumulative_baseline_refs", "governed_delta_refs"],
      "additionalProperties": false
    },
    "change_roots": {"type": "array", "items": {"$ref": "#/$defs/ChangeRoot"}, "minItems": 1},
    "impact_binding": {
      "type": "object",
      "properties": {
        "impact_proof_id": {"$ref": "newrouge.b-route-common.v1#/$defs/Digest"},
        "impact_input_digest": {"$ref": "newrouge.b-route-common.v1#/$defs/Digest"},
        "partition_digests": {
          "type": "object",
          "additionalProperties": {"$ref": "newrouge.b-route-common.v1#/$defs/Digest"}
        },
        "conservative_expanded": {"type": "boolean"},
        "unknown_items": {"type": "array", "items": {"$ref": "#/$defs/UnknownItem"}},
        "expansion_reasons": {"type": "array", "items": {"$ref": "newrouge.b-route-common.v1#/$defs/String"}},
        "transitive_summary": {
          "type": "object",
          "properties": {
            "flows": {"type": "integer", "minimum": 0},
            "tasks": {"type": "integer", "minimum": 0},
            "tests": {"type": "integer", "minimum": 0},
            "requirements": {"type": "integer", "minimum": 0},
            "obligations": {"type": "integer", "minimum": 0},
            "other_verification": {"type": "integer", "minimum": 0},
            "implementation_objects": {"type": "integer", "minimum": 0}
          },
          "required": ["flows", "tasks", "tests", "requirements", "obligations", "other_verification", "implementation_objects"],
          "additionalProperties": false
        }
      },
      "required": [
        "impact_proof_id", "impact_input_digest", "partition_digests", "conservative_expanded", "unknown_items",
        "expansion_reasons", "transitive_summary"
      ],
      "additionalProperties": false
    },
    "obligations": {"type": "array", "items": {"$ref": "#/$defs/Obligation"}},
    "flow_classifications": {"type": "array", "items": {"$ref": "#/$defs/FlowClassification"}},
    "execution_plan": {
      "type": "object",
      "properties": {
        "executable_tests": {"type": "array", "items": {"$ref": "#/$defs/ExecutableTest"}},
        "pending_obligations": {"type": "array", "items": {"$ref": "#/$defs/PendingObligation"}},
        "manual_obligations": {"type": "array", "items": {"$ref": "#/$defs/ManualObligation"}},
        "other_verification_obligations": {"type": "array", "items": {"$ref": "#/$defs/OtherVerificationObligation"}}
      },
      "required": ["executable_tests", "pending_obligations", "manual_obligations", "other_verification_obligations"],
      "additionalProperties": false
    },
    "applied_delta_changes": {"type": "array", "items": {"$ref": "#/$defs/AppliedDeltaChange"}},
    "blocking_gaps": {"type": "array", "items": {"$ref": "#/$defs/Gap"}},
    "scope_status": {"enum": ["executable_ready", "blocked_incomplete_or_broken"]},
    "scope_closable": {"type": "boolean"},
    "all_current_obligations_executable": {"type": "boolean"},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/DiagnosticItem"}},
    "report_path": {"$ref": "#/$defs/NullableString"},
    "metrics": {"$ref": "#/$defs/Metrics"},
    "scope_authorizes_verification_only": {"const": true},
    "task_completed": {"const": false},
    "flow_completed": {"const": false},
    "milestone_completed": {"const": false},
    "runtime_verified": {"const": false},
    "task_status_mutated": {"const": false},
    "publish_pointer_mutated": {"const": false},
    "default_b_enabled": {"const": false}
  },
  "required": [
    "schema_version", "ok", "status", "operation", "reason_code", "generated_at", "scope_id", "input_set_digest",
    "task_input_set_digests", "request", "delivery_boundary", "authority_refs", "change_roots", "impact_binding",
    "obligations", "flow_classifications", "execution_plan", "applied_delta_changes", "blocking_gaps", "scope_status",
    "scope_closable", "all_current_obligations_executable", "diagnostics", "report_path", "metrics",
    "scope_authorizes_verification_only", "task_completed", "flow_completed", "milestone_completed",
    "runtime_verified", "task_status_mutated", "publish_pointer_mutated", "default_b_enabled"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"scope_status": {"const": "executable_ready"}}},
      "then": {
        "properties": {
          "scope_closable": {"const": true},
          "all_current_obligations_executable": {"const": true},
          "blocking_gaps": {"maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "scope_closable": {"const": false},
          "all_current_obligations_executable": {"const": false}
        }
      }
    }
  ]
}
